# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Without these, the site still builds and runs —
# Sign In / Sign Up show a "not configured" notice and /dashboard just
# requires an account to exist, which it won't until this is set up.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set this in Vercel's project env vars once deployed and Vercel
# will automatically send it as a Bearer token when it triggers the
# /api/cleanup cron (see vercel.json). Not needed for local dev.
CRON_SECRET=

# Required for the /contact form to send email (see src/pages/api/contact.ts).
# Get a key at https://resend.com. Without it, the form shows an error instead
# of sending. Sandbox mode (the default until you verify a domain) only
# delivers to the email address your Resend account was created with.
RESEND_API_KEY=
