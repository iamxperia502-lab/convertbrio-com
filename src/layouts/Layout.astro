---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  // Only meaningful when noindex is true — pages that shouldn't be indexed
  // (e.g. coming-soon tools, error pages) but still link to real content
  // should stay crawlable so link equity flows through, rather than being
  // walled off with nofollow.
  follow?: boolean;
  // Omits the canonical tag entirely. Use for pages that shouldn't claim a
  // canonical URL at all, like 404s (there's no "canonical" version of a
  // page that doesn't exist).
  noCanonical?: boolean;
}

const {
  title,
  description = "Convert, compress, and enhance your images, PDFs, and documents online. Fast, private, and free file tools.",
  seoTitle,
  canonical,
  image = "/web-app-manifest-512x512.png",
  noindex = false,
  follow = true,
  noCanonical = false,
} = Astro.props;

const pageTitle = seoTitle ?? (title === "ConvertBrio" ? title : `${title} · ConvertBrio`);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
const robotsContent = `${noindex ? "noindex" : "index"}, ${follow ? "follow" : "nofollow"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4630473399054348"
     crossorigin="anonymous"></script>

    <!-- Google Consent Mode v2: default to denied for analytics/ad storage
         until the visitor makes a choice in the cookie banner (see
         ConsentBanner.astro) or in Google's own EU consent message (see
         Privacy & messaging in AdSense, which now also runs on this site).
         Must run before gtag.js/GTM load so the first hit already carries
         the denied signal. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Microsoft Clarity is gated on analytics consent regardless of which
      // system granted it - our own banner or Google's EU consent message -
      // since both ultimately speak the same Consent Mode dataLayer/gtag
      // protocol. Installed here, before anything else can push, so it
      // catches the very first consent update on the page.
      (function () {
        var clarityLoaded = false;
        function loadClarity() {
          if (clarityLoaded) return;
          clarityLoaded = true;
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i + "?ref=bwt";
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "y5upif9itn");
        }
        var originalPush = dataLayer.push.bind(dataLayer);
        dataLayer.push = function () {
          for (var i = 0; i < arguments.length; i++) {
            var entry = arguments[i];
            if (entry && entry[0] === "consent" && entry[1] === "update" && entry[2] && entry[2].analytics_storage === "granted") {
              loadClarity();
            }
          }
          return originalPush.apply(dataLayer, arguments);
        };
      })();

      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
      (function () {
        try {
          var stored = JSON.parse(localStorage.getItem('cb-consent') || 'null');
          if (stored && stored.version === 1) {
            gtag('consent', 'update', {
              analytics_storage: stored.analytics ? 'granted' : 'denied',
              ad_storage: stored.advertising ? 'granted' : 'denied',
              ad_user_data: stored.advertising ? 'granted' : 'denied',
              ad_personalization: stored.advertising ? 'granted' : 'denied'
            });
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VL3MYT4NBN"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-VL3MYT4NBN');
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T23N9GHH');</script>
    <!-- End Google Tag Manager -->

    <!-- Microsoft Clarity loads only after analytics consent is granted —
         see ConsentBanner.astro, which injects it on accept. -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ConvertBrio" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {!noCanonical && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" id="theme-color-meta" content="#ffffff" />

    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        var meta = document.getElementById("theme-color-meta");
        if (meta) meta.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ConvertBrio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts are self-hosted (src/styles/global.css) so there's no
         render-blocking request to fonts.googleapis.com; this just
         warms the connection for the body-text weight actually needed
         for first paint. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T23N9GHH"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-canvas"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <SpeedInsights />
  </body>
</html>
