---
import Icon from "./Icon.astro";

const points = [
  {
    icon: "lock",
    title: "Encrypted in transit",
    desc: "Files travel over HTTPS/TLS. Our storage providers (Vercel Blob, Supabase) state they encrypt stored data at rest; see the Trust & Security page for details.",
  },
  {
    icon: "clock",
    title: "Automatic deletion",
    desc: "Your original upload is deleted right after it is read for conversion. Converted results are removed by a daily cleanup job, typically within about 24 hours.",
  },
  {
    icon: "eye",
    title: "Fully automated",
    desc: "Conversion is handled entirely by automated processes: no one manually opens or reviews your file as part of it.",
  },
] as const;
---

<section aria-labelledby="security-heading" class="border-b border-hairline bg-neutral-900">
  <div class="container-page py-16 text-white sm:py-20">
    <div class="mb-10 flex flex-col items-start gap-3 sm:mb-12 sm:max-w-xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1 font-mono text-xs text-white/70">
        <Icon name="shield" class="h-3.5 w-3.5" />
        Privacy by design
      </span>
      <h2 id="security-heading" class="text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">
        Your files, your business. Nobody else’s.
      </h2>
      <p class="text-white/70">
        We built ConvertBrio so your documents never linger longer than it takes to convert them.
      </p>
      <p class="text-sm text-white/50">
        Every tool works the same way: your browser uploads the file, our hosting providers' servers (Vercel and Supabase) do the actual
        conversion, and the original and the result are deleted automatically: the original right after it is read, the result by a daily cleanup (see Trust & Security for exact timing).
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        points.map((point) => (
          <div class="flex flex-col gap-3 rounded-xl border border-white/10 p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white">
              <Icon name={point.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-base font-semibold text-white">{point.title}</h3>
            <p class="text-sm leading-relaxed text-white/65">{point.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
