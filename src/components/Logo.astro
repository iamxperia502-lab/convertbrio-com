---
interface Props {
  size?: number;
  showWordmark?: boolean;
  class?: string;
}

const { size = 40, class: className = "" } = Astro.props;
---

<a
  href="/"
  class={`inline-flex shrink-0 items-center rounded-sm ${className}`}
  aria-label="ConvertBrio home"
>
  <img
    src="/logo.png"
    alt="ConvertBrio"
    width="1600"
    height="364"
    style={`height:${size}px`}
    class="w-auto dark:hidden"
  />
  <img
    src="/logo-dark.png"
    alt="ConvertBrio"
    width="1600"
    height="364"
    style={`height:${size}px`}
    class="hidden w-auto dark:block"
  />
</a>
