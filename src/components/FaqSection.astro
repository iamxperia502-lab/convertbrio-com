---
import Icon from "./Icon.astro";
import { homepageFaq } from "../data/faq";

const link = "inline-flex w-fit items-center gap-1.5 text-sm font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700";
---

<section id="faq" aria-labelledby="faq-heading" class="border-b border-hairline bg-canvas">
  <div class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 id="faq-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">
        Frequently Asked Questions
      </h2>
      <p class="mt-3 leading-relaxed text-body">
        Answers to common questions about converting, compressing, and managing files with ConvertBrio's free online file converter.
      </p>

      <div class="mt-8 flex flex-col gap-3">
        {
          homepageFaq.map((item, index) => (
            <details class="group rounded-xl border border-hairline bg-canvas-soft p-5 open:pb-5" name="faq-accordion">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">
                <span id={`faq-q-${index}`}>{item.question}</span>
                <Icon
                  name="chevronDown"
                  class="h-4 w-4 shrink-0 text-mute transition-transform duration-150 group-open:rotate-180"
                />
              </summary>
              <div class="mt-3 flex flex-col gap-2" role="region" aria-labelledby={`faq-q-${index}`}>
                <p class="text-sm leading-relaxed text-body">{item.answer}</p>
                {item.link && (
                  <a href={item.link.href} class={link}>
                    {item.link.label}
                    <Icon name="arrow" class="h-3.5 w-3.5" />
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
