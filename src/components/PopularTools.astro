---
import Icon from "./Icon.astro";

const tools = [
  { name: "Reduce Image to 100 KB", desc: "Hit an exact target file size.", icon: "scale", href: "/tools/compress-image" },
  { name: "Passport Photo Maker", desc: "White background, auto-cropped.", icon: "idCard", href: "/tools/passport-photo-maker" },
  { name: "Image Converter", desc: "Convert JPG, PNG, WEBP, and more.", icon: "image", href: "/tools/image-converter" },
  { name: "HEIC to JPG", desc: "Convert iPhone photos instantly.", icon: "heic", href: "/tools/heic-to-jpg" },
  { name: "Merge PDF", desc: "Combine multiple PDFs into one.", icon: "merge", href: "/tools/merge-pdf" },
  { name: "Compress PDF", desc: "Reduce PDF file size in seconds.", icon: "shrink", href: "/tools/compress-pdf" },
  { name: "PDF to Word", desc: "Turn PDFs into editable DOCX.", icon: "pdf", href: "/tools/pdf-to-word" },
  { name: "Word to PDF", desc: "Convert documents to PDF.", icon: "word", href: "/tools/word-to-pdf" },
  { name: "OCR PDF", desc: "Extract text from scanned pages.", icon: "ocr", href: "/tools/ocr-pdf" },
] as const;
---

<section aria-labelledby="popular-tools-heading" class="border-b border-hairline bg-canvas">
  <div class="container-page py-16 sm:py-20">
    <div class="mb-10 flex flex-col gap-2 sm:mb-12">
      <h2 id="popular-tools-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">
        Popular tools
      </h2>
      <p class="text-body">The tools people reach for most.</p>
    </div>

    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex h-full flex-col gap-3 rounded-xl border border-hairline bg-canvas p-5 shadow-card transition-all duration-150 hover:-translate-y-0.5 hover:border-hairline-strong hover:shadow-card-lg"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink transition-colors group-hover:bg-lime group-hover:text-ink">
                <Icon name={tool.icon} class="h-5 w-5" />
              </span>
              <span class="flex flex-col gap-1">
                <span class="text-sm font-medium text-ink">{tool.name}</span>
                <span class="text-xs leading-relaxed text-mute">{tool.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
