---
// Real, measured evidence for the Compress Image tool: every number here
// came from actually running a file through the live /api/convert/image
// endpoint (the same code path a real user hits), not from estimates or
// marketing copy. See the methodology note below for exactly how.
// The measurements are identical in every language; only the text around
// them is localised (data/benchmark-content.ts).
import { benchmarkText } from "../data/benchmark-content";
import type { Locale } from "../data/i18n";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = benchmarkText[lang];
const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? "");
// Measured values stay exactly as recorded; only the unit label is localised.
const unit = (value: string) => value.replace(" KB", ` ${t.kb}`);

const sizeResults = [
  { target: "200 KB", achieved: "199.7 KB", bytes: "204,495", ratio: "4.1×", downscaled: false, file: "/benchmarks/compress-image-200kb.jpg", width: 2000, height: 1500 },
  { target: "100 KB", achieved: "99.2 KB", bytes: "101,640", ratio: "8.2×", downscaled: false, file: "/benchmarks/compress-image-100kb.jpg", width: 2000, height: 1500 },
  { target: "50 KB", achieved: "48.1 KB", bytes: "49,314", ratio: "16.9×", downscaled: false, file: "/benchmarks/compress-image-50kb.jpg", width: 2000, height: 1500 },
  { target: "20 KB", achieved: "14.9 KB", bytes: "15,357", ratio: "54.3×", downscaled: true, file: "/benchmarks/compress-image-20kb.jpg", width: 1700, height: 1275 },
] as const;

const formatMatrix = [
  { input: "JPEG", output: "JPEG" },
  { input: "PNG", output: "PNG" },
  { input: "WEBP", output: "WEBP" },
  { input: "AVIF", output: "AVIF" },
  { input: "GIF", output: "GIF" },
  { input: "HEIC / HEIF", output: "JPEG" },
] as const;

const linkClass = "font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700";
---

<section aria-labelledby="benchmark-heading" class="border-b border-hairline bg-canvas">
  <div class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <h2 id="benchmark-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">
        {t.heading}
      </h2>
      <p class="mt-4 leading-relaxed text-body">{t.intro}</p>

      <div class="mt-6 rounded-xl border border-hairline bg-canvas-soft p-5 text-sm leading-relaxed text-body">
        <p class="font-medium text-ink">{t.methodologyLabel}</p>
        <p class="mt-2">
          {t.methodologyBefore}<code class="rounded bg-canvas-soft-2 px-1 py-0.5 font-mono text-xs">/api/convert/image</code>{t.methodologyAfter}
        </p>
      </div>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.beforeAfterHeading}</h3>
      <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-5">
        <figure class="flex flex-col gap-2">
          <img
            src="/benchmarks/compress-image-original.jpg"
            alt={t.originalAlt}
            class="aspect-[4/3] w-full rounded-lg border border-hairline object-cover"
            width="2000"
            height="1500"
            loading="lazy"
          />
          <figcaption class="text-xs text-mute">
            <span class="block font-medium text-ink">{t.originalLabel}</span>
            {unit("814.8 KB")} · 2000×1500
          </figcaption>
        </figure>
        {
          sizeResults.map((r) => (
            <figure class="flex flex-col gap-2">
              <img
                src={r.file}
                alt={fill(t.compressedAlt, { target: unit(r.target), achieved: unit(r.achieved) })}
                class="aspect-[4/3] w-full rounded-lg border border-hairline object-cover"
                width={r.width}
                height={r.height}
                loading="lazy"
              />
              <figcaption class="text-xs text-mute">
                <span class="block font-medium text-ink">{fill(t.targetLabel, { target: unit(r.target) })}</span>
                {fill(t.achievedLabel, { achieved: unit(r.achieved) })}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.resultsHeading}</h3>
      <div class="mt-4 overflow-x-auto rounded-xl border border-hairline">
        <table class="w-full min-w-[560px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-hairline bg-canvas-soft text-xs uppercase tracking-wide text-mute">
              <th class="px-4 py-3 font-medium">{t.thTarget}</th>
              <th class="px-4 py-3 font-medium">{t.thAchieved}</th>
              <th class="px-4 py-3 font-medium">{t.thDimensions}</th>
              <th class="px-4 py-3 font-medium">{t.thRatio}</th>
              <th class="px-4 py-3 font-medium">{t.thHit}</th>
            </tr>
          </thead>
          <tbody>
            {
              sizeResults.map((r, i) => (
                <tr class={i < sizeResults.length - 1 ? "border-b border-hairline" : ""}>
                  <td class="px-4 py-3 text-ink">{unit(r.target)}</td>
                  <td class="px-4 py-3 text-body">
                    {unit(r.achieved)} <span class="text-mute">({r.bytes} {t.bytes})</span>
                  </td>
                  <td class="px-4 py-3 text-body">
                    {r.width} × {r.height} {r.downscaled ? t.widthReduced : t.unchanged}
                  </td>
                  <td class="px-4 py-3 text-body">{fill(t.smaller, { ratio: r.ratio })}</td>
                  <td class="px-4 py-3 text-success">{t.yes}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-mute">{t.resultsNote}</p>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.formatHeading}</h3>
      <p class="mt-3 leading-relaxed text-body">{t.formatBody}</p>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.matrixHeading}</h3>
      <div class="mt-4 overflow-x-auto rounded-xl border border-hairline">
        <table class="w-full min-w-[480px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-hairline bg-canvas-soft text-xs uppercase tracking-wide text-mute">
              <th class="px-4 py-3 font-medium">{t.thInput}</th>
              <th class="px-4 py-3 font-medium">{t.thOutput}</th>
              <th class="px-4 py-3 font-medium">{t.thNotes}</th>
            </tr>
          </thead>
          <tbody>
            {
              formatMatrix.map((row, i) => (
                <tr class={i < formatMatrix.length - 1 ? "border-b border-hairline" : ""}>
                  <td class="px-4 py-3 text-ink">{row.input}</td>
                  <td class="px-4 py-3 text-body">{row.output}</td>
                  <td class="px-4 py-3 text-mute">{t.matrixNotes[i] || t.na}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.howHeading}</h3>
      <p class="mt-3 leading-relaxed text-body">
        {t.howBefore}<a href="https://sharp.pixelplumbing.com/" class={linkClass} rel="nofollow">sharp</a>{t.howAfter}
      </p>

      <h3 class="mt-10 text-lg font-semibold text-ink">{t.limitsHeading}</h3>
      <ul class="mt-3 flex flex-col gap-3 text-body">
        {
          t.limits.map((item) => (
            <li class="flex gap-2.5">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
