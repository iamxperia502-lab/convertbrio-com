---
import Layout from "../layouts/Layout.astro";
import PageIntro from "./PageIntro.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import { alternatesFor, localizeHtml, localePath, type Locale } from "../data/i18n";
import { aboutByLocale } from "../data/about-content";
import { founderName, founderPhoto, founderBio, businessDetails, personalLinkedIn } from "../data/about-profile";
import { liveToolCount } from "../data/tools";
import { organization, founderId, orgId } from "../lib/structured-data";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const s = aboutByLocale[lang];

const base = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.convertbrio.com";
const aboutPath = localePath("/about", lang);
const fill = (text: string) =>
  localizeHtml(text, lang).replaceAll("{name}", founderName).replaceAll("{count}", String(liveToolCount)).replaceAll("{url}", personalLinkedIn ?? "");

const bio = founderBio[lang] ?? [];
const business = businessDetails
  .map((row) => ({ label: row.label[lang] ?? row.label.en, value: row.value }))
  .filter((row): row is { label: string; value: string } => Boolean(row.label));

const structuredData = [
  organization(base),
  {
    "@type": "Person",
    "@id": founderId(base),
    name: founderName,
    url: `${base}/about`,
    jobTitle: s.role,
    worksFor: { "@id": orgId(base) },
    ...(founderPhoto ? { image: `${base}${founderPhoto}` } : {}),
    ...(personalLinkedIn ? { sameAs: [personalLinkedIn] } : {}),
  },
  {
    "@type": "AboutPage",
    "@id": `${base}${aboutPath}#page`,
    url: `${base}${aboutPath}`,
    name: s.schemaName,
    inLanguage: lang,
    about: { "@id": orgId(base) },
  },
];

// Dev-only reminder (English page) of what the owner still has to supply.
const missing = [
  !founderPhoto && "founder photo",
  !founderBio.en?.length && "founder background (2–3 sentences)",
  businessDetails.length === 0 && "business registration details",
  !personalLinkedIn && "personal LinkedIn URL",
].filter(Boolean) as string[];

const prose = "[&_a]:font-medium [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-brand-700";
const icons = ["shrink", "shield", "sparkle"] as const;
---

<Layout
  alternates={alternatesFor("/about")}
  canonical={aboutPath}
  lang={lang}
  title={s.title}
  description={s.description}
  jsonLd={structuredData}
>
  <PageIntro eyebrow={s.eyebrow} title={s.heading} description={s.intro} />

  {
    import.meta.env.DEV && lang === "en" && missing.length > 0 && (
      <div class="border-b border-hairline bg-canvas-soft">
        <div class="container-page py-4 text-sm text-body">
          <strong class="text-ink">Dev only: still to fill in (src/data/about-profile.ts):</strong> {missing.join(", ")}.
        </div>
      </div>
    )
  }

  <section aria-labelledby="founder-heading" class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        {
          founderPhoto ? (
            <img src={founderPhoto} alt={fill(s.photoAlt)} width="160" height="160" loading="lazy" class="h-40 w-40 shrink-0 rounded-2xl object-cover" />
          ) : (
            <div aria-hidden="true" class="flex h-40 w-40 shrink-0 items-center justify-center rounded-2xl bg-canvas-soft-2 text-4xl font-semibold text-ink">SS</div>
          )
        }
        <div class:list={["max-w-2xl", prose]}>
          <h2 id="founder-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink">{s.founderHeading}</h2>
          <p class="mt-1 text-sm text-mute">{founderName} · {s.role}</p>
          <p class="mt-4 leading-relaxed text-body" set:html={fill(s.founderIntro)} />
          {bio.map((paragraph) => <p class="mt-4 leading-relaxed text-body">{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="why-heading" class="border-b border-hairline bg-canvas">
    <div class:list={["container-page flex flex-col gap-4 py-16 sm:py-20", prose]}>
      <h2 id="why-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink">{s.whyHeading}</h2>
      <p class="max-w-2xl leading-relaxed text-body">{s.whyP1}</p>
      <p class="max-w-2xl leading-relaxed text-body" set:html={fill(s.whyP2)} />
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          s.values.map((value, i) => (
            <div class="flex flex-col gap-3 rounded-xl border border-hairline bg-canvas p-6 shadow-card">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink">
                <Icon name={icons[i % 3]} class="h-5 w-5" />
              </span>
              <h3 class="text-base font-semibold text-ink">{value.title}</h3>
              <p class="text-sm leading-relaxed text-body">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="how-heading" class="border-b border-hairline bg-canvas">
    <div class:list={["container-page flex flex-col gap-4 py-16 sm:py-20", prose]}>
      <h2 id="how-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink">{s.howHeading}</h2>
      <p class="max-w-2xl leading-relaxed text-body">{fill(s.howP1)}</p>
      <p class="max-w-2xl leading-relaxed text-body" set:html={fill(s.howP2)} />
    </div>
  </section>

  {
    business.length > 0 && (
      <section aria-labelledby="business-heading" class="border-b border-hairline bg-canvas">
        <div class="container-page py-16 sm:py-20">
          <h2 id="business-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink">{s.businessHeading}</h2>
          <dl class="mt-6 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-[auto_1fr]">
            {business.map((row) => (
              <>
                <dt class="text-sm font-medium text-ink">{row.label}</dt>
                <dd class="text-sm text-body">{row.value}</dd>
              </>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <section aria-labelledby="contact-heading" class="bg-canvas">
    <div class:list={["container-page flex flex-col gap-4 py-16 sm:py-20", prose]}>
      <h2 id="contact-heading" class="text-2xl font-semibold tracking-[-0.01em] text-ink">{s.contactHeading}</h2>
      <p class="max-w-2xl leading-relaxed text-body" set:html={fill(s.contactP1)} />
      <SocialLinks />
      {personalLinkedIn && <p class="max-w-2xl text-sm text-body" set:html={fill(s.linkedinLine)} />}
      <p class="max-w-2xl text-sm text-mute" set:html={fill(s.servicesLine)} />
    </div>
  </section>
</Layout>
