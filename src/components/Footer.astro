---
import { ui, localePath, LOCALIZED_TOOL_SLUGS, toolMetaByLocale, type Locale } from "../data/i18n";

interface Props {
  lang?: Locale;
}
const { lang = "en" } = Astro.props;
const t = ui[lang].footer;

// In a localised footer, link tool names to their /<lang>/ page and use the
// translated name; anything without a localised page links to the English URL.
const localizedSlugs = new Set<string>(LOCALIZED_TOOL_SLUGS);
function toolLink(slug: string, enLabel: string) {
  if (lang !== "en" && localizedSlugs.has(slug)) {
    return { label: toolMetaByLocale[lang]?.[slug]?.name ?? enLabel, href: `/${lang}/tools/${slug}` };
  }
  return { label: enLabel, href: `/tools/${slug}` };
}

const columns = [
  {
    heading: t.convert,
    links: [
      toolLink("image-converter", "Image Converter"),
      lang === "en" ? { label: "HEIC to JPG", href: "/tools/heic-to-jpg" } : toolLink("jpg-to-pdf", "JPG to PDF"),
      toolLink("word-to-pdf", "Word to PDF"),
      toolLink("pdf-to-word", "PDF to Word"),
    ],
  },
  {
    heading: t.compress,
    links: [
      toolLink("compress-pdf", "Compress PDF"),
      toolLink("compress-image", "Image Compressor"),
      toolLink("compress-powerpoint", "Compress PowerPoint"),
    ],
  },
  {
    heading: t.tools,
    links: [
      { label: ui[lang].nav.pdf, href: localePath("/all-tools#pdf", lang) },
      { label: ui[lang].nav.image, href: localePath("/all-tools#image", lang) },
      { label: ui[lang].nav.document, href: localePath("/all-tools#document", lang) },
      { label: ui[lang].nav.allTools, href: localePath("/all-tools", lang) },
    ],
  },
  {
    heading: t.company,
    links: [
      { label: t.about, href: localePath("/about", lang) },
      { label: t.blog, href: localePath("/blog", lang) },
      { label: t.contact, href: localePath("/contact", lang) },
    ],
  },
  {
    heading: t.legal,
    links: [
      { label: t.privacy, href: localePath("/privacy", lang) },
      { label: t.terms, href: localePath("/terms", lang) },
      { label: t.trust, href: localePath("/trust", lang) },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <a href={localePath("/", lang)} class="inline-flex items-center" aria-label="ConvertBrio home">
          <img src="/logo.png" alt="ConvertBrio" width="1600" height="364" class="h-10 w-auto dark:hidden" />
          <img src="/logo-dark.png" alt="ConvertBrio" width="1600" height="364" class="hidden h-10 w-auto dark:block" />
        </a>
        <p class="mt-3 max-w-[22ch] text-sm leading-relaxed text-mute">{t.tagline}</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="font-mono text-xs uppercase tracking-wide text-mute">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-body transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-hairline pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <p class="text-sm text-mute">© {year} ConvertBrio. {t.rights}</p>
        <span class="hidden text-mute sm:inline">·</span>
        <a
          href="https://convertbrio.info"
          target="_blank"
          rel="noopener"
          class="text-sm text-mute underline underline-offset-2 transition-colors hover:text-ink"
        >
          Check out my other work ↗
        </a>
      </div>
      <div class="flex items-center gap-4">
        <button
          type="button"
          id="cb-manage-cookies-link"
          class="text-sm text-mute underline underline-offset-2 transition-colors hover:text-ink"
        >
          {t.manageCookies}
        </button>
        <p class="text-sm text-mute">convertbrio.com</p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.getElementById("cb-manage-cookies-link");
    if (!btn) return;
    btn.addEventListener("click", function () {
      // Reopens Google's own EU consent message (AdSense > Privacy &
      // messaging), the only consent UI on this site. googlefc.callbackQueue
      // and showRevocationMessage() are Google's documented public API for
      // exactly this "manage/withdraw consent" use case.
      if (window.googlefc && window.googlefc.callbackQueue) {
        window.googlefc.callbackQueue.push({
          CONSENT_DATA_READY: function () {
            window.googlefc.showRevocationMessage();
          },
        });
      }
    });
  })();
</script>
