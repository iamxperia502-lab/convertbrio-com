---
const columns = [
  {
    heading: "Convert",
    links: [
      { label: "Image Converter", href: "/tools/image-converter" },
      { label: "HEIC to JPG", href: "/tools/heic-to-jpg" },
      { label: "Word to PDF", href: "/tools/word-to-pdf" },
      { label: "PDF to Word", href: "/tools/pdf-to-word" },
    ],
  },
  {
    heading: "Compress",
    links: [
      { label: "Image Compressor", href: "/tools/compress-image" },
      { label: "Compress PDF", href: "/tools/compress-pdf" },
    ],
  },
  {
    heading: "Tools",
    links: [
      { label: "PDF Tools", href: "/all-tools#pdf" },
      { label: "Image Tools", href: "/all-tools#image" },
      { label: "Document Tools", href: "/all-tools#document" },
      { label: "AI Tools", href: "/all-tools#ai" },
      { label: "All Tools", href: "/all-tools" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Blog", href: "/blog" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms of Service", href: "/terms" },
      { label: "Trust & Security", href: "/trust" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2" aria-label="ConvertBrio home">
          <svg width="24" height="24" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="26" height="26" rx="7" fill="#16171B" />
            <path d="M8 13.5L11.2 16.7L18 9.3" stroke="#EEF1FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span translate="no" class="text-[15px] font-semibold tracking-[-0.01em] text-ink">ConvertBrio</span>
        </a>
        <p class="mt-3 max-w-[22ch] text-sm leading-relaxed text-mute">Convert. Compress. Enhance.</p>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.heading}>
            <h2 class="font-mono text-xs uppercase tracking-wide text-mute">{col.heading}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-body transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-hairline pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-mute">© {year} ConvertBrio. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <button
          type="button"
          id="cb-manage-cookies-link"
          class="text-sm text-mute underline underline-offset-2 transition-colors hover:text-ink"
        >
          Manage cookie preferences
        </button>
        <p class="text-sm text-mute">convertbrio.com</p>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var btn = document.getElementById("cb-manage-cookies-link");
    if (!btn) return;
    btn.addEventListener("click", function () {
      // Reopens Google's own EU consent message (AdSense > Privacy &
      // messaging), the only consent UI on this site. googlefc.callbackQueue
      // and showRevocationMessage() are Google's documented public API for
      // exactly this "manage/withdraw consent" use case.
      if (window.googlefc && window.googlefc.callbackQueue) {
        window.googlefc.callbackQueue.push({
          CONSENT_DATA_READY: function () {
            window.googlefc.showRevocationMessage();
          },
        });
      }
    });
  })();
</script>
