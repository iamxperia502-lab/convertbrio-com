---
// Cookie consent banner: Accept all / Reject all / Manage.
// Gates Google Consent Mode v2 signals (Microsoft Clarity loading is gated
// centrally in Layout.astro, from either consent source below).
//
// Google's own EU consent message (AdSense > Privacy & messaging) now also
// runs on this site, geo-targeted at EEA/UK/Swiss visitors. Both speak the
// same Consent Mode dataLayer/gtag protocol, so to avoid showing two
// consent banners to the same visitor, this banner defers to Google's
// message wherever it applies (detected via the standard IAB TCF
// `gdprApplies` flag that any TCF CMP, including Google's, exposes on
// window.__tcfapi) and only shows itself elsewhere, or as a fallback if
// Google's CMP script never loads (e.g. blocked by an ad/tracker blocker).
//
// Reopens via a "cb:open-consent" window event (see Footer's "Manage cookie
// preferences" link) so consent can be withdrawn or changed at any time -
// routed to Google's own revocation flow for visitors deferred to it.
---

<div
  id="cb-consent-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-hairline bg-canvas p-4 shadow-card-lg sm:p-6"
  role="dialog"
  aria-modal="false"
  aria-label="Cookie preferences"
>
  <div class="container-page flex flex-col gap-4">
    <div id="cb-consent-summary" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-sm text-body">
        We use cookies for essential site functions and, with your consent, for analytics and
        advertising. See our <a href="/privacy" class="font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700">Privacy Policy</a> for details.
      </p>
      <div class="flex shrink-0 flex-wrap gap-2">
        <button type="button" id="cb-consent-manage" class="rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft-2">
          Manage options
        </button>
        <button type="button" id="cb-consent-reject" class="rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink hover:bg-canvas-soft-2">
          Reject all
        </button>
        <button type="button" id="cb-consent-accept" class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas hover:opacity-90">
          Accept all
        </button>
      </div>
    </div>

    <div id="cb-consent-details" class="hidden flex-col gap-4 border-t border-hairline pt-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-ink">Essential</p>
          <p class="text-sm text-mute">Required for sign-in and core site functionality. Always on.</p>
        </div>
        <input type="checkbox" checked disabled class="mt-1 h-4 w-4" aria-label="Essential cookies (always on)" />
      </div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-ink">Analytics</p>
          <p class="text-sm text-mute">Google Analytics and Microsoft Clarity, used to understand aggregate product usage.</p>
        </div>
        <input type="checkbox" id="cb-consent-toggle-analytics" class="mt-1 h-4 w-4" aria-label="Analytics cookies" />
      </div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-ink">Advertising</p>
          <p class="text-sm text-mute">Used by Google and advertising partners to serve and measure ads, once enabled on this site.</p>
        </div>
        <input type="checkbox" id="cb-consent-toggle-advertising" class="mt-1 h-4 w-4" aria-label="Advertising cookies" />
      </div>
      <div>
        <button type="button" id="cb-consent-save" class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas hover:opacity-90">
          Save preferences
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = "cb-consent";
    var VERSION = 1;

    function readConsent() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (parsed && parsed.version === VERSION) return parsed;
        return null;
      } catch (e) {
        return null;
      }
    }

    function writeConsent(analytics, advertising) {
      var record = { version: VERSION, analytics: !!analytics, advertising: !!advertising, timestamp: new Date().toISOString() };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
      } catch (e) {
        // localStorage unavailable (private browsing, blocked storage) — consent
        // still applies for this page load via window.__cbConsent.
      }
      window.__cbConsent = record;
      return record;
    }

    function applyConsent(record) {
      window.gtag =
        window.gtag ||
        function () {
          (window.dataLayer = window.dataLayer || []).push(arguments);
        };
      window.gtag("consent", "update", {
        analytics_storage: record.analytics ? "granted" : "denied",
        ad_storage: record.advertising ? "granted" : "denied",
        ad_user_data: record.advertising ? "granted" : "denied",
        ad_personalization: record.advertising ? "granted" : "denied",
      });
    }

    var banner = document.getElementById("cb-consent-banner");
    var details = document.getElementById("cb-consent-details");
    var analyticsToggle = document.getElementById("cb-consent-toggle-analytics");
    var advertisingToggle = document.getElementById("cb-consent-toggle-advertising");

    function openBanner(showDetails) {
      if (!banner) return;
      var existing = readConsent();
      if (existing) {
        analyticsToggle.checked = existing.analytics;
        advertisingToggle.checked = existing.advertising;
      }
      banner.classList.remove("hidden");
      if (showDetails) details.classList.remove("hidden");
    }

    function closeBanner() {
      if (!banner) return;
      banner.classList.add("hidden");
      details.classList.add("hidden");
    }

    function tryOwnBanner() {
      var existing = readConsent();
      if (existing) {
        applyConsent(existing);
      } else {
        openBanner(false);
      }
    }

    // true once this visitor is confirmed governed by Google's own EU
    // consent message instead of this banner (see the file-level comment).
    var useGoogleCmp = false;
    var decided = false;

    if (window.__tcfapi) {
      window.__tcfapi("addEventListener", 2, function (tcData, success) {
        if (decided || !success || typeof tcData.gdprApplies !== "boolean") return;
        decided = true;
        if (tcData.gdprApplies) {
          useGoogleCmp = true;
        } else {
          tryOwnBanner();
        }
      });
      // Google's CMP is required to install window.__tcfapi essentially
      // immediately, but fall back to our own banner if it never resolves
      // (e.g. the AdSense script itself got blocked) so visitors always get
      // asked by someone.
      setTimeout(function () {
        if (decided) return;
        decided = true;
        tryOwnBanner();
      }, 1500);
    } else {
      tryOwnBanner();
    }

    document.getElementById("cb-consent-accept").addEventListener("click", function () {
      applyConsent(writeConsent(true, true));
      closeBanner();
    });
    document.getElementById("cb-consent-reject").addEventListener("click", function () {
      applyConsent(writeConsent(false, false));
      closeBanner();
    });
    document.getElementById("cb-consent-manage").addEventListener("click", function () {
      details.classList.toggle("hidden");
    });
    document.getElementById("cb-consent-save").addEventListener("click", function () {
      applyConsent(writeConsent(analyticsToggle.checked, advertisingToggle.checked));
      closeBanner();
    });

    window.addEventListener("cb:open-consent", function () {
      if (useGoogleCmp && window.googlefc && window.googlefc.callbackQueue) {
        window.googlefc.callbackQueue.push({
          CONSENT_DATA_READY: function () {
            window.googlefc.showRevocationMessage();
          },
        });
        return;
      }
      openBanner(true);
    });
  })();
</script>
