---
import Layout from "../layouts/Layout.astro";
import PageIntro from "./PageIntro.astro";
import Icon from "./Icon.astro";
import { alternatesFor, localizeHtml, type Locale } from "../data/i18n";
import { liveToolCount } from "../data/tools";
import type { StaticPageDoc, AboutDoc } from "../data/page-content/types";

interface Props {
  doc: StaticPageDoc | AboutDoc;
  lang: Locale;
  /** English path of this page, e.g. "/privacy". */
  enPath: string;
}
const { doc, lang, enPath } = Astro.props;
const h = (s: string) => localizeHtml(s, lang).replaceAll("{liveToolCount}", String(liveToolCount));
const values = "values" in doc ? doc.values : undefined;
const valueIcons = ["shrink", "shield", "sparkle"] as const;
---

<Layout
  title={doc.title}
  seoTitle={doc.seoTitle}
  description={doc.description}
  canonical={`/${lang}${enPath}`}
  lang={lang}
  alternates={alternatesFor(enPath)}
>
  <PageIntro eyebrow={doc.eyebrow} title={doc.heading} description={doc.intro} />

  {
    values && (
      <section class="bg-canvas">
        <div class="container-page py-16 sm:py-20">
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            {values.map((value, i) => (
              <div class="flex flex-col gap-3 rounded-xl border border-hairline bg-canvas p-6 shadow-card">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink">
                  <Icon name={valueIcons[i % 3]} class="h-5 w-5" />
                </span>
                <h2 class="text-base font-semibold text-ink">{value.title}</h2>
                <p class="text-sm leading-relaxed text-body">{value.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <article class="prose prose-neutral max-w-2xl prose-headings:font-semibold prose-headings:tracking-[-0.01em] prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline">
        {
          doc.blocks.map((block) => (
            <>
              {block.heading && <h2>{block.heading}</h2>}
              {block.paragraphs?.map((p) => <p set:html={h(p)} />)}
              {block.list && <ul>{block.list.map((li) => <li set:html={h(li)} />)}</ul>}
            </>
          ))
        }
      </article>
    </div>
  </section>
</Layout>
