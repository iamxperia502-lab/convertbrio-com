---
import { languages } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const currentLang = Astro.currentLocale ?? "en";
const t = useTranslations(currentLang);
const pathname = Astro.url.pathname;
const hash = Astro.url.hash;
---

<div class={`relative ${className}`} data-language-switcher>
  <button
    type="button"
    class="inline-flex items-center gap-1 rounded-full px-3 py-2 text-sm text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={t("nav.language")}
  >
    <span aria-hidden="true">🌐</span>
    <span class="uppercase">{currentLang}</span>
  </button>
  <ul
    class="absolute right-0 z-50 mt-1 hidden min-w-[9rem] rounded-xl border border-hairline bg-canvas py-1.5 shadow-card"
    role="menu"
  >
    {
      Object.entries(languages).map(([code, label]) => (
        <li role="none">
          <a
            role="menuitem"
            href={getLocalizedPath(pathname, code, hash)}
            aria-current={code === currentLang ? "true" : undefined}
            class={`block px-4 py-2 text-sm transition-colors hover:bg-canvas-soft-2 ${
              code === currentLang ? "font-medium text-ink" : "text-body"
            }`}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll("[data-language-switcher]").forEach((wrapper) => {
    const button = wrapper.querySelector("button");
    const menu = wrapper.querySelector("ul");
    if (!button || !menu) return;

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
    });

    document.addEventListener("click", (event) => {
      if (!wrapper.contains(event.target as Node)) {
        button.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
      }
    });
  });
</script>
