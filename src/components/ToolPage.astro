---
import Layout from "../layouts/Layout.astro";
import PageIntro from "./PageIntro.astro";
import { hubForTool } from "../data/hubs";
import ToolFeedback from "./ToolFeedback.astro";
import ToolExtras from "./ToolExtras.astro";
import PdfOrganizer from "./PdfOrganizer.astro";
import Icon from "./Icon.astro";
import ToolContent from "./ToolContent.astro";
import FaqSection from "./FaqSection.astro";
import CompressImageBenchmark from "./CompressImageBenchmark.astro";
import { getTool, isComingSoon } from "../data/tools";
import { toolContent } from "../data/toolContent";
import { toolContentByLocale } from "../data/tool-content";
import { ui, localePath, toolMetaByLocale, LOCALIZED_TOOL_SLUGS, NON_DEFAULT_LOCALES, type Locale } from "../data/i18n";

interface Props {
  slug: string;
  lang?: Locale;
}

const { slug, lang = "en" } = Astro.props;
const isDefault = lang === "en";
const t = ui[lang].tool;
const tf = t.form;

const tool = getTool(slug)!;
// External tools never reach this component (dedicated redirect routes).
if (tool.kind === "external") {
  return Astro.redirect(tool.externalUrl, 302);
}

// Display strings (name/description/SEO) get a localised override where one
// exists; behaviour fields (kind/operation/accept/…) always come from `tool`.
const meta = isDefault ? undefined : toolMetaByLocale[lang]?.[slug];
const name = meta?.name ?? tool.name;
const description = meta?.description ?? tool.description;
const seoTitle = meta?.seoTitle ?? tool.seoTitle;
const seoDescription = meta?.seoDescription ?? tool.seoDescription ?? description;

const endpoint =
  tool.kind === "image" ? "/api/convert/image" :
  tool.kind === "pdf" ? "/api/convert/pdf" :
  tool.kind === "office" ? "/api/convert/office" :
  tool.kind === "ai" ? "/api/convert/ai" :
  tool.kind === "ocr" ? "/api/convert/ocr" :
  tool.kind === "metadata" ? "/api/convert/metadata" :
  null;

// Non-personal descriptors read by the form script for analytics events.
const analyticsCategory = tool.categories[0] ?? "convert";
const analyticsOutput =
  (tool.kind === "image" && tool.outputFormat) ||
  (("operation" in tool && tool.operation.match(/-to-([a-z]+)$/)?.[1]) || "");

const hub = isDefault ? hubForTool(tool) : undefined;

const rawContent = isDefault ? toolContent[slug] : toolContentByLocale[lang]?.[slug];
const isGuide = isComingSoon(tool) && !!(isDefault ? toolContent[slug]?.comingSoonGuide : undefined);
const content = !isComingSoon(tool) || isGuide ? rawContent : undefined;

const base = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.convertbrio.com";
const pfx = (path: string) => localePath(path, lang);

const isLocalized = (LOCALIZED_TOOL_SLUGS as readonly string[]).includes(slug);
const alternates = isLocalized
  ? {
      en: `/tools/${slug}`,
      ...Object.fromEntries(NON_DEFAULT_LOCALES.map((l) => [l, `/${l}/tools/${slug}`])),
    }
  : undefined;

const HOME_LABEL: Record<Locale, string> = {
  en: "Home", pt: "Início", es: "Inicio", fr: "Accueil", de: "Startseite", it: "Home", id: "Beranda",
};
const homeLabel = HOME_LABEL[lang];
const faqSchema = content && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const howToSchema =
  content && content.howTo && content.howTo.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `${t.howToHeading}: ${name} · ConvertBrio`,
        step: content.howTo.map((item, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          name: item.step,
          text: item.detail ? `${item.step} ${item.detail}` : item.step,
        })),
      }
    : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: homeLabel, item: `${base}${pfx("/")}` },
    { "@type": "ListItem", position: 2, name: ui[lang].nav.allTools, item: `${base}${pfx("/all-tools")}` },
    { "@type": "ListItem", position: 3, name, item: `${base}${pfx(`/tools/${slug}`)}` },
  ],
};

const softwareApplicationSchema = isComingSoon(tool)
  ? null
  : {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name,
      url: `${base}${pfx(`/tools/${slug}`)}`,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any (web-based)",
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    };
---

<Layout
  title={name}
  seoTitle={seoTitle}
  description={seoDescription}
  noindex={isComingSoon(tool)}
  follow
  lang={lang}
  alternates={alternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    {softwareApplicationSchema && <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
    {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} is:inline />}
  </Fragment>

  <PageIntro eyebrow={isGuide ? t.eyebrowGuide : t.eyebrowTool} title={name} description={description} />

  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl">
        {
          isGuide && content?.comingSoonGuide ? (
            <div class="rounded-2xl border border-hairline bg-canvas-soft p-6 shadow-card sm:p-8">
              <span class="inline-flex items-center gap-2 rounded-full bg-canvas-soft-2 px-3 py-1 text-xs font-medium text-body">
                <Icon name="clock" class="h-3.5 w-3.5" />
                {t.oneClickInDev}
              </span>
              <h2 class="mt-4 text-lg font-semibold text-ink">{content.comingSoonGuide.title}</h2>
              {(Array.isArray(content.comingSoonGuide.intro)
                ? content.comingSoonGuide.intro
                : [content.comingSoonGuide.intro]
              ).map((paragraph) => (
                <p class="mt-2 leading-relaxed text-body">{paragraph}</p>
              ))}
              <a
                href={content.comingSoonGuide.cta.href}
                class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
              >
                {content.comingSoonGuide.cta.label}
                <Icon name="arrow" class="h-4 w-4" />
              </a>
            </div>
          ) : isComingSoon(tool) ? (
            <div class="flex flex-col items-center gap-4 rounded-2xl border border-dashed border-hairline-strong px-6 py-14 text-center">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                <Icon name="clock" class="h-6 w-6" />
              </span>
              <p class="text-lg font-medium text-ink">{t.comingSoon}</p>
              <p class="max-w-sm text-sm text-body">{tool.comingSoonReason}</p>
              <a href={pfx("/all-tools")} class="mt-2 text-sm text-brand-600 underline underline-offset-2 hover:text-brand-700">
                {t.browseOtherTools}
              </a>
            </div>
          ) : (
            <form
              id="tool-form"
              data-endpoint={endpoint}
              data-i18n-uploading={tf.uploading}
              data-i18n-processing={tf.processing}
              data-i18n-choose-first={tf.chooseFirst}
              data-i18n-error={tf.genericError}
              data-i18n-done={tf.doneTemplate}
              data-i18n-download={tf.downloadTemplate}
              data-i18n-files-selected={tf.filesSelectedTemplate}
              data-i18n-error-network={tf.errorNetwork}
              data-i18n-error-upload={tf.errorUpload}
              data-i18n-error-too-large={tf.errorTooLarge}
              data-i18n-error-unsupported={tf.errorUnsupported}
              data-i18n-error-conversion={tf.errorConversion}
              data-i18n-error-download={tf.errorDownload}
              data-i18n-feedback-thanks={tf.feedbackThanks}
              data-tool-slug={tool.slug}
              data-tool-category={analyticsCategory}
              data-tool-output={analyticsOutput}
              data-tool-mode={tool.kind}
              data-tool-op={"operation" in tool ? tool.operation : ""}
              data-accept={tool.accept ?? ""}
              class="flex flex-col gap-6 rounded-2xl border border-hairline bg-canvas-soft p-6 shadow-card sm:p-8"
            >
              <input type="hidden" name="slug" value={tool.slug} />

              <label
                for="file-input"
                id="dropzone"
                class="group flex cursor-pointer flex-col items-center gap-3 rounded-xl border-2 border-dashed border-hairline-strong px-6 py-12 text-center transition-colors duration-150 hover:border-lime-deep hover:bg-lime/10"
              >
                <div id="dropzone-idle" class="flex flex-col items-center gap-3">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-canvas-soft-2 text-ink transition-colors group-hover:bg-lime group-hover:text-ink">
                    <Icon name="cloud" class="h-5 w-5" />
                  </span>
                  <span class="text-sm font-medium text-ink">
                    {tool.multiple ? tf.dropMultiple : tf.dropSingle}
                  </span>
                  <span class="text-xs text-mute">{tool.multiple ? tf.sizeLimitTotal : tf.sizeLimit}</span>
                </div>

                <div id="dropzone-uploading" class="hidden w-full max-w-[16rem] flex-col items-center gap-3">
                  <span id="progress-percent" class="text-3xl font-semibold tabular-nums text-ink">0%</span>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-canvas-soft-2">
                    <div id="progress-bar" class="h-full w-0 rounded-full bg-lime-deep transition-[width] duration-150 ease-out" />
                  </div>
                  <span id="progress-label" class="text-xs text-mute">{tf.uploading}</span>
                </div>

                <div id="dropzone-done" class="hidden flex-col items-center gap-2">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-success-soft text-success">
                    <Icon name="check" class="h-5 w-5" />
                  </span>
                  <span id="done-filename" class="max-w-full truncate text-sm font-medium text-ink" />
                  <span class="text-xs text-mute">{tf.replaceHint}</span>
                </div>

                <input id="file-input" name="file" type="file" accept={tool.accept} multiple={tool.multiple} required class="sr-only" />
              </label>

              {
                tool.kind === "image" && tool.operation === "convert" && !tool.outputFormat && (
                  <div class="flex flex-col gap-1.5">
                    <label for="format" class="text-sm font-medium text-ink">{tf.convertTo}</label>
                    <select id="format" name="format" class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus">
                      <option value="jpeg">JPG</option>
                      <option value="png">PNG</option>
                      <option value="webp">WEBP</option>
                      <option value="avif">AVIF</option>
                      <option value="gif">GIF</option>
                    </select>
                  </div>
                )
              }

              {
                tool.kind === "image" && tool.operation === "compress" && (
                  <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1.5">
                      <label for="targetKb" class="text-sm font-medium text-ink">{tf.targetSizeKb}</label>
                      <input
                        id="targetKb"
                        name="targetKb"
                        type="number"
                        min="5"
                        placeholder="100"
                        class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus"
                      />
                      <span class="text-xs text-mute">{tf.targetSizeHint}</span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label for="quality" class="text-sm font-medium text-ink">{tf.quality}</label>
                      <input id="quality" name="quality" type="range" min="20" max="95" value="60" class="accent-lime-deep" />
                    </div>
                  </div>
                )
              }

              {
                tool.kind === "image" && tool.operation === "resize" && (
                  <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                      <label for="width" class="text-sm font-medium text-ink">{tf.width}</label>
                      <input id="width" name="width" type="number" min="1" class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label for="height" class="text-sm font-medium text-ink">{tf.height}</label>
                      <input id="height" name="height" type="number" min="1" class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                  </div>
                )
              }

              {
                tool.kind === "image" && tool.operation === "crop" && (
                  <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                      <label for="left" class="text-sm font-medium text-ink">{tf.left}</label>
                      <input id="left" name="left" type="number" min="0" required class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label for="top" class="text-sm font-medium text-ink">{tf.top}</label>
                      <input id="top" name="top" type="number" min="0" required class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label for="width" class="text-sm font-medium text-ink">{tf.width}</label>
                      <input id="width" name="width" type="number" min="1" required class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label for="height" class="text-sm font-medium text-ink">{tf.height}</label>
                      <input id="height" name="height" type="number" min="1" required class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus" />
                    </div>
                  </div>
                )
              }

              {
                "operation" in tool && tool.operation === "rotate" && (
                  <div class="flex flex-col gap-1.5">
                    <label for="degrees" class="text-sm font-medium text-ink">{tf.rotate}</label>
                    <select id="degrees" name="degrees" class="h-11 rounded-lg border border-hairline bg-canvas px-3.5 text-sm text-ink focus:border-focus">
                      <option value="90">90°</option>
                      <option value="180">180°</option>
                      <option value="270">270°</option>
                    </select>
                  </div>
                )
              }

              <ToolExtras slug={tool.slug} />
              {tool.slug === "pdf-page-organizer" && <PdfOrganizer />}

              <div class="flex gap-3">
                <button
                  id="reset-btn"
                  type="button"
                  class="hidden items-center justify-center gap-2 rounded-full border border-hairline-strong bg-canvas px-6 py-3 text-sm font-medium text-ink transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {tf.reupload}
                </button>

                <button
                  type="submit"
                  class="inline-flex flex-1 items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {tf.convert}
                </button>
              </div>

              <div id="result-list" class="hidden flex-col gap-2 rounded-xl border border-hairline bg-canvas p-4 text-sm" aria-live="polite"></div>
              <div id="text-result" class="hidden flex-col gap-2">
                <textarea id="text-result-area" readonly rows="8" class="w-full rounded-lg border border-hairline bg-canvas p-3.5 text-sm text-ink focus:border-focus"></textarea>
                <button
                  id="text-copy-btn"
                  type="button"
                  class="inline-flex items-center justify-center rounded-full border border-hairline-strong bg-canvas px-5 py-2 text-sm font-medium text-ink transition-opacity hover:opacity-90"
                >
                  Copy text
                </button>
              </div>

              <a
                id="download-link"
                href="#"
                class="hidden items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
              >
                <Icon name="download" class="h-4 w-4" />
                <span id="download-link-label">{tf.downloadResult}</span>
              </a>

              <ToolFeedback
                question={tf.feedbackQuestion}
                yes={tf.feedbackYes}
                no={tf.feedbackNo}
                reasonLabel={tf.feedbackReasonLabel}
                reasons={tf.feedbackReasons}
              />

              <p id="tool-status" role="status" aria-live="polite" class="text-center text-sm text-body" />
            </form>
          )
        }
        {
          hub && (
            <p class="mt-6 text-center text-sm text-body">
              <a href={hub.path} class="text-brand-600 underline underline-offset-2 hover:text-brand-700">
                More {hub.name.toLowerCase()}
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>

  {tool.slug === "compress-image" && <CompressImageBenchmark lang={lang} />}

  {
    content && (
      <>
        <ToolContent
          title={content.title}
          intro={content.intro}
          howTo={content.howTo}
          howToHeading={t.howToHeading}
          relatedHeading={t.relatedHeading}
          sections={content.sections}
          relatedTools={content.relatedTools}
        />
        <FaqSection items={content.faq} heading={`${name}: ${t.faqSuffix}`} description={content.faqDescription} id={`faq-${tool.slug}`} />
      </>
    )
  }

  {
    !isComingSoon(tool) && (
      <script>
        import { submitConversion, createDownloadHandle } from "../lib/upload-client";
        import { track, sizeBand, formatOf, toolContextFrom } from "../lib/analytics";
        import { ConversionError, toConversionError, messageFor } from "../lib/conversion-errors";
        import { matchesAccept } from "../lib/file-validation";
        import { initToolFeedback } from "../lib/tool-feedback";

        const form = document.getElementById("tool-form") as HTMLFormElement | null;
        const dropzone = document.getElementById("dropzone");
        const dropzoneIdle = document.getElementById("dropzone-idle");
        const dropzoneUploading = document.getElementById("dropzone-uploading");
        const dropzoneDone = document.getElementById("dropzone-done");
        const doneFilename = document.getElementById("done-filename");
        const fileInput = document.getElementById("file-input") as HTMLInputElement | null;
        const status = document.getElementById("tool-status");
        const progressPercent = document.getElementById("progress-percent");
        const progressBar = document.getElementById("progress-bar");
        const progressLabel = document.getElementById("progress-label");
        const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const resetButton = document.getElementById("reset-btn") as HTMLButtonElement | null;
        const downloadLink = document.getElementById("download-link") as HTMLAnchorElement | null;
        const downloadLinkLabel = document.getElementById("download-link-label");
        const downloadHandle = downloadLink ? createDownloadHandle(downloadLink) : null;

        const d = form?.dataset ?? ({} as DOMStringMap);
        const S = {
          uploading: d.i18nUploading ?? "Uploading…",
          processing: d.i18nProcessing ?? "Processing…",
          chooseFirst: d.i18nChooseFirst ?? "Choose a file first.",
          error: d.i18nError ?? "Something went wrong. Try again.",
          done: d.i18nDone ?? "Done: {file} downloaded. If it didn't start, use the button below.",
          download: d.i18nDownload ?? "Download {file}",
          filesSelected: d.i18nFilesSelected ?? "{n} files selected",
        };
        const errorMessages = {
          network: d.i18nErrorNetwork ?? S.error,
          upload: d.i18nErrorUpload ?? S.error,
          tooLarge: d.i18nErrorTooLarge ?? S.error,
          unsupported: d.i18nErrorUnsupported ?? S.error,
          conversion: d.i18nErrorConversion ?? S.error,
          generic: S.error,
        };

        const toolCtx = toolContextFrom(form);
        const accept = d.accept ?? "";
        const feedback = initToolFeedback(toolCtx, d.i18nFeedbackThanks ?? "Thanks for the feedback.");

        const selectionParams = (files: File[]) => ({
          ...toolCtx,
          input_format: [...new Set(files.map(formatOf))].join(","),
          file_count: files.length,
          size_band: sizeBand(files.reduce((n, f) => n + f.size, 0)),
        });

        const resultList = document.getElementById("result-list");
        const textResult = document.getElementById("text-result");
        const textArea = document.getElementById("text-result-area") as HTMLTextAreaElement | null;
        const copyButton = document.getElementById("text-copy-btn");
        const extraHandles: { revoke: () => void }[] = [];

        const clearExtraResults = () => {
          extraHandles.splice(0).forEach((h) => h.revoke());
          if (resultList) {
            resultList.textContent = "";
            resultList.classList.add("hidden");
            resultList.classList.remove("flex");
          }
          textResult?.classList.add("hidden");
          textResult?.classList.remove("flex");
          if (textArea) textArea.value = "";
        };

        // Text results (OCR) are shown as selectable text; ZIP results from
        // the batch compressor also get one download link per file.
        const showExtraResults = async (blob: Blob) => {
          try {
            if (blob.type.startsWith("text/plain") && textArea && textResult) {
              textArea.value = await blob.text();
              textResult.classList.remove("hidden");
              textResult.classList.add("flex");
            } else if (d.toolOp === "batch-compress" && resultList) {
              const { default: JSZip } = await import("jszip");
              const zip = await JSZip.loadAsync(blob);
              const report = JSON.parse((await zip.file("report.json")?.async("string")) ?? "[]") as {
                input: string;
                output?: string;
                ok: boolean;
                bytes?: number;
                targetMet?: boolean;
                error?: string;
              }[];
              for (const row of report) {
                const line = document.createElement("div");
                line.className = "flex flex-wrap items-center justify-between gap-2";
                const label = document.createElement("span");
                label.className = "min-w-0 truncate text-body";
                if (!row.ok || !row.output) {
                  label.textContent = `${row.input}: could not be processed${row.error ? ` (${row.error})` : ""}`;
                  line.appendChild(label);
                } else {
                  const kb = ((row.bytes ?? 0) / 1024).toFixed(1);
                  label.textContent = `${row.input}: ${kb} KB${row.targetMet ? "" : " (above target)"}`;
                  const entry = zip.file(row.output);
                  line.appendChild(label);
                  if (entry) {
                    const data = await entry.async("blob");
                    const a = document.createElement("a");
                    const handle = createDownloadHandle(a);
                    handle.set(data, row.output);
                    a.textContent = "Download";
                    a.className = "font-medium text-brand-600 underline underline-offset-2";
                    a.addEventListener("click", (e) => {
                      if (e.isTrusted) track("download_completed", toolCtx);
                    });
                    extraHandles.push(handle);
                    line.appendChild(a);
                  }
                }
                resultList.appendChild(line);
              }
              resultList.classList.remove("hidden");
              resultList.classList.add("flex");
            }
          } catch {
            // The main download link still works if the extras can't render.
          }
        };

        copyButton?.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(textArea?.value ?? "");
            if (status) status.textContent = "Text copied.";
          } catch {
            textArea?.select();
          }
        });

        const hideDownloadLink = () => {
          clearExtraResults();
          downloadHandle?.revoke();
          downloadLink?.classList.add("hidden");
          downloadLink?.classList.remove("flex");
          feedback.hide();
        };

        const setProgress = (percent: number) => {
          if (progressBar) progressBar.style.width = `${percent}%`;
          if (progressPercent) progressPercent.textContent = `${percent}%`;
        };

        // The upload phase has real byte-level progress from the browser, but
        // the server does the actual conversion in one synchronous pass with
        // no progress channel back to the client. So the upload gets a slice
        // of the bar (0-UPLOAD_WEIGHT%), and once it finishes, a trickle
        // animation eases the rest toward PROCESSING_CEILING - never claiming
        // 100% before the response actually arrives.
        const UPLOAD_WEIGHT = 35;
        const PROCESSING_CEILING = 96;
        let processingTimer: number | undefined;

        const stopProcessingTrickle = () => {
          if (processingTimer !== undefined) {
            window.clearInterval(processingTimer);
            processingTimer = undefined;
          }
          progressBar?.classList.remove("animate-pulse");
        };

        const startProcessingTrickle = (startPercent: number) => {
          let current = startPercent;
          if (progressLabel) progressLabel.textContent = S.processing;
          progressBar?.classList.add("animate-pulse");
          processingTimer = window.setInterval(() => {
            current += (PROCESSING_CEILING - current) * 0.06;
            const rounded = Math.min(PROCESSING_CEILING, Math.round(current));
            setProgress(rounded);
            if (status) status.textContent = `${S.processing} ${rounded}%`;
          }, 200);
        };

        const showIdle = () => {
          dropzoneUploading?.classList.add("hidden");
          dropzoneUploading?.classList.remove("flex");
          dropzoneDone?.classList.add("hidden");
          dropzoneDone?.classList.remove("flex");
          dropzoneIdle?.classList.remove("hidden");
          resetButton?.classList.add("hidden");
          resetButton?.classList.remove("inline-flex");
          hideDownloadLink();
        };

        const showUploading = () => {
          dropzoneIdle?.classList.add("hidden");
          dropzoneDone?.classList.add("hidden");
          dropzoneDone?.classList.remove("flex");
          dropzoneUploading?.classList.remove("hidden");
          dropzoneUploading?.classList.add("flex");
          resetButton?.classList.add("hidden");
          resetButton?.classList.remove("inline-flex");
          hideDownloadLink();
        };

        const showDone = (label: string) => {
          dropzoneIdle?.classList.add("hidden");
          dropzoneUploading?.classList.add("hidden");
          dropzoneUploading?.classList.remove("flex");
          dropzoneDone?.classList.remove("hidden");
          dropzoneDone?.classList.add("flex");
          if (doneFilename) doneFilename.textContent = label;
          resetButton?.classList.remove("hidden");
          resetButton?.classList.add("inline-flex");
        };

        const resetForm = () => {
          if (fileInput) fileInput.value = "";
          if (status) status.textContent = "";
          stopProcessingTrickle();
          setProgress(0);
          if (progressLabel) progressLabel.textContent = S.uploading;
          showIdle();
        };

        resetButton?.addEventListener("click", resetForm);

        const selectedFileLabel = (files: FileList) =>
          files.length > 1 ? S.filesSelected.replace("{n}", String(files.length)) : files[0].name;

        // Validates a picked/dropped selection. An invalid one is rejected with
        // a specific message and the form is left usable.
        const acceptSelection = (files: FileList): boolean => {
          const list = [...files];
          if (accept && list.some((f) => !matchesAccept(f, accept))) {
            if (fileInput) fileInput.value = "";
            if (status) status.textContent = errorMessages.unsupported;
            showIdle();
            track("conversion_failed", { ...selectionParams(list), error_category: "unsupported_format" });
            return false;
          }
          if (list.reduce((n, f) => n + f.size, 0) > 100 * 1024 * 1024) {
            if (fileInput) fileInput.value = "";
            if (status) status.textContent = errorMessages.tooLarge;
            showIdle();
            track("conversion_failed", { ...selectionParams(list), error_category: "file_too_large" });
            return false;
          }
          if (status) status.textContent = "";
          hideDownloadLink();
          showDone(selectedFileLabel(files));
          track("file_selected", selectionParams(list));
          return true;
        };

        fileInput?.addEventListener("change", () => {
          if (fileInput.files?.length) acceptSelection(fileInput.files);
          else {
            hideDownloadLink();
            showIdle();
          }
        });

        ["dragenter", "dragover"].forEach((eventName) => {
          dropzone?.addEventListener(eventName, (event) => {
            event.preventDefault();
            dropzone.classList.add("border-lime-deep", "bg-lime/10");
          });
        });
        ["dragleave", "drop"].forEach((eventName) => {
          dropzone?.addEventListener(eventName, (event) => {
            event.preventDefault();
            dropzone.classList.remove("border-lime-deep", "bg-lime/10");
          });
        });
        dropzone?.addEventListener("drop", (event) => {
          const dt = (event as DragEvent).dataTransfer;
          if (dt?.files?.length && fileInput) {
            fileInput.files = dt.files;
            acceptSelection(dt.files);
          }
        });

        // Only a genuine user activation of the persistent link counts: the
        // automatic programmatic click below can't prove a file was saved.
        downloadLink?.addEventListener("click", (event) => {
          if (!event.isTrusted) return;
          track("download_completed", toolCtx);
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const endpoint = form.dataset.endpoint;
          if (!endpoint || !status) return;
          // A conversion is already running; the button is disabled, but
          // Enter-key submits must not start a second one.
          if (submitButton?.disabled) return;

          if (!fileInput?.files?.length) {
            status.textContent = S.chooseFirst;
            return;
          }

          const files = [...fileInput.files];
          const params = selectionParams(files);

          submitButton?.setAttribute("disabled", "true");
          showUploading();
          setProgress(0);
          if (progressLabel) progressLabel.textContent = S.uploading;
          status.textContent = `${S.uploading} 0%`;
          track("conversion_started", params);

          try {
            const { filename, blob, note, targetMet } = await submitConversion({
              endpoint,
              formData: new FormData(form),
              onProgress: (percent) => {
                const weighted = Math.round((percent / 100) * UPLOAD_WEIGHT);
                setProgress(weighted);
                status.textContent = `${S.uploading} ${percent}%`;
              },
              onUploaded: () => {
                startProcessingTrickle(UPLOAD_WEIGHT);
              },
            });

            stopProcessingTrickle();
            setProgress(100);
            // A server note (achieved size, per-file results, ...) replaces the
            // generic message; a missed size target is never reported as done.
            status.textContent = note ?? S.done.replace("{file}", filename);
            if (fileInput.files?.length) showDone(selectedFileLabel(fileInput.files));
            track("conversion_completed", params);
            await showExtraResults(blob);
            if (downloadHandle && downloadLink) {
              downloadHandle.set(blob, filename);
              if (downloadLinkLabel) downloadLinkLabel.textContent = S.download.replace("{file}", filename);
              downloadLink.classList.remove("hidden");
              downloadLink.classList.add("flex");
              try {
                if (targetMet !== false) downloadLink.click();
              } catch {
                status.textContent = d.i18nErrorDownload ?? S.error;
              }
            }
            feedback.show();
          } catch (err) {
            const failure = err instanceof ConversionError ? err : toConversionError(err, "unknown");
            status.textContent = messageFor(failure, errorMessages);
            track("conversion_failed", { ...params, error_category: failure.category });
            // Restore a usable form (file still selected) without a reload.
            if (fileInput.files?.length) showDone(selectedFileLabel(fileInput.files));
            else showIdle();
          } finally {
            stopProcessingTrickle();
            submitButton?.removeAttribute("disabled");
          }
        });
      </script>
    )
  }
</Layout>
