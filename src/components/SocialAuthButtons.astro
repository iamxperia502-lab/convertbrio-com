---
interface Props {
  next?: string;
  disabled?: boolean;
}

const { next = "/dashboard", disabled = false } = Astro.props;

const providers = [
  { id: "google", label: "Continue with Google" },
  { id: "microsoft", label: "Continue with Microsoft" },
] as const;

const buttonClass =
  "inline-flex h-11 w-full items-center justify-center gap-2.5 rounded-full border border-hairline bg-canvas px-4 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2 aria-disabled:pointer-events-none aria-disabled:opacity-50";
---

<div class="flex flex-col gap-3">
  {
    providers.map((provider) => (
      <a
        href={disabled ? undefined : `/api/auth/oauth?provider=${provider.id}&next=${encodeURIComponent(next)}`}
        aria-disabled={disabled}
        role="button"
        class={buttonClass}
      >
        {provider.id === "google" && (
          <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.47a5.54 5.54 0 0 1-2.4 3.63v3h3.87c2.27-2.09 3.58-5.17 3.58-8.82Z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.87-3c-1.08.72-2.46 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.95H1.28v3.11A12 12 0 0 0 12 24Z" />
            <path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.6H1.28a12 12 0 0 0 0 10.8l3.99-3.11Z" />
            <path fill="#EA4335" d="M12 4.75c1.76 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.28 6.6l3.99 3.11C6.22 6.86 8.87 4.75 12 4.75Z" />
          </svg>
        )}
        {provider.id === "microsoft" && (
          <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="1" y="1" width="10" height="10" fill="#F25022" />
            <rect x="13" y="1" width="10" height="10" fill="#7FBA00" />
            <rect x="1" y="13" width="10" height="10" fill="#00A4EF" />
            <rect x="13" y="13" width="10" height="10" fill="#FFB900" />
          </svg>
        )}
        {provider.label}
      </a>
    ))
  }
</div>
