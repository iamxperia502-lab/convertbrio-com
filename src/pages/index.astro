---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import UploadBox from "../components/UploadBox.astro";
import PopularTools from "../components/PopularTools.astro";
import ToolCategories from "../components/ToolCategories.astro";
import SecuritySection from "../components/SecuritySection.astro";
import CtaSection from "../components/CtaSection.astro";
import SeoContent from "../components/SeoContent.astro";
import FaqSection from "../components/FaqSection.astro";
import { homepageFaq } from "../data/faq";
import { liveToolCount } from "../data/tools";

const seoTitle = "ConvertBrio — Free Online File Converter & Compressor";
const description = `Convert, compress, and edit images, PDFs, and documents online — free, private, and no sign-up. ${liveToolCount} tools, including an image compressor that hits an exact KB target.`;
const siteUrl = "https://www.convertbrio.com/";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ConvertBrio",
  url: siteUrl,
  description,
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ConvertBrio",
  url: siteUrl,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (web-based)",
  description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Layout title="ConvertBrio" seoTitle={seoTitle} description={description} canonical="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Hero />
  <UploadBox />
  <PopularTools />
  <ToolCategories />
  <SecuritySection />
  <SeoContent />
  <FaqSection />
  <CtaSection />
</Layout>
