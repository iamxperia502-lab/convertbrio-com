---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import UploadBox from "../components/UploadBox.astro";
import PopularTools from "../components/PopularTools.astro";
import ToolCategories from "../components/ToolCategories.astro";
import SecuritySection from "../components/SecuritySection.astro";
import CtaSection from "../components/CtaSection.astro";
import SeoContent from "../components/SeoContent.astro";
import FaqSection from "../components/FaqSection.astro";
import { homepageFaq } from "../data/faq";
import { liveToolCount } from "../data/tools";
import { alternatesFor } from "../data/i18n";
import { organization, webSite, faqPage } from "../lib/structured-data";

const seoTitle = "ConvertBrio: Free Online File Converter & Compressor";
const description = `Convert, compress & edit images, PDFs, and documents online: free, private, no sign-up. ${liveToolCount} tools including an image compressor that compresses to your KB target.`;
const siteUrl = "https://www.convertbrio.com/";

const siteBase = siteUrl.replace(/\/$/, "");
const jsonLd = [organization(siteBase), webSite(siteBase, { description, lang: "en", url: siteUrl }), faqPage(homepageFaq)];
---

<Layout
  title="ConvertBrio"
  seoTitle={seoTitle}
  description={description}
  canonical="/"
  lang="en"
  alternates={alternatesFor("/")}
  jsonLd={jsonLd}
>
  <Hero>
    <UploadBox />
  </Hero>
  <PopularTools />
  <ToolCategories />
  <SecuritySection />
  <SeoContent />
  <FaqSection />
  <CtaSection />
</Layout>
