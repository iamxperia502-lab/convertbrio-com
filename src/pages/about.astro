---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { alternatesFor } from "../data/i18n";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import { liveToolCount } from "../data/tools";

const values = [
  {
    icon: "shrink",
    title: "Fast by default",
    desc: "Every tool is built to process files in seconds, not minutes, no matter the queue.",
  },
  {
    icon: "shield",
    title: "Private by design",
    desc: "Files are encrypted and automatically deleted. We never sell or review your data.",
  },
  {
    icon: "sparkle",
    title: "Genuinely useful AI",
    desc: "AI tools that solve real problems, enhancement, restoration, and cleanup, not gimmicks.",
  },
] as const;

---

<Layout
  alternates={alternatesFor("/about")}
  title="About"
  description="ConvertBrio builds fast, private, and simple file conversion tools for images, PDFs, and documents."
>
  <PageIntro
    eyebrow="About ConvertBrio"
    title="File tools that get out of your way"
    description="ConvertBrio started with a simple idea: converting a file shouldn't require installing software, creating an account, or waiting in a queue."
  />

  <section aria-label="Our values" class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          values.map((value) => (
            <div class="flex flex-col gap-3 rounded-xl border border-hairline bg-canvas p-6 shadow-card">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas-soft-2 text-ink">
                <Icon name={value.icon} class="h-5 w-5" />
              </span>
              <h2 class="text-base font-semibold text-ink">{value.title}</h2>
              <p class="text-sm leading-relaxed text-body">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-label="Our approach" class="bg-canvas">
    <div class="container-page flex flex-col gap-4 py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink">Our approach</h2>
      <p class="max-w-2xl leading-relaxed text-body">
        We focus on the tools people actually use every day, image conversion, PDF editing,
        document formatting, and compression, and make each one fast, accurate, and free to
        use. {liveToolCount} tools are live today, with more shipping regularly. Where AI
        genuinely improves a result, like enhancing a low-resolution photo, we use it. Where it
        wouldn't help, we leave it out.
      </p>
      <p class="max-w-2xl leading-relaxed text-body">
        ConvertBrio is independently built and operated by Subham Sharma, based in India. If you
        have feedback, a security concern, or a tool you’d like to see, <a href="/contact" class="font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700">reach out</a> or read how we handle your files in our <a href="/privacy" class="font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700">Privacy Policy</a>.
      </p>
    </div>
  </section>
</Layout>
