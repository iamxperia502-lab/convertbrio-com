---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";

// Only Free is real right now: there's no billing system, no plan
// enforcement anywhere in the API, and no way to actually become a paid
// user. Pro/Business tiers with specific prices and feature claims (1 GB
// files, priority processing, team seats, API access) were listed here
// before but none of it was buildable/purchasable — publishing that
// alongside an AdSense application would be exactly the kind of false
// functionality claim Google's policies prohibit. Bring them back once
// billing and the features they promise actually exist.
const features = [
  "Files up to 25 MB per conversion",
  "No sign-up required",
  "Access to every tool",
  "256-bit encryption and automatic file deletion",
] as const;
---

<Layout title="Pricing" description="ConvertBrio is free to use — every tool, no sign-up, no paid tier yet.">
  <PageIntro
    eyebrow="Pricing"
    title="Free, for now"
    description="ConvertBrio doesn't have a paid plan yet. Everything below is what you get today, at no cost."
  />

  <section aria-label="Pricing" class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto flex max-w-md flex-col gap-6 rounded-2xl border border-hairline bg-canvas p-8 text-ink shadow-card">
        <div>
          <h2 class="text-lg font-semibold text-ink">Free</h2>
          <p class="mt-1 text-sm text-mute">Everything ConvertBrio currently offers.</p>
        </div>

        <div class="flex items-baseline gap-1.5">
          <span class="text-4xl font-semibold tracking-[-0.02em]">$0</span>
          <span class="text-sm text-mute">/forever</span>
        </div>

        <ul class="flex flex-col gap-3">
          {
            features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-success" />
                <span class="text-body">{feature}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/all-tools"
          class="mt-auto inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
        >
          Browse tools
        </a>
      </div>

      <p class="mx-auto mt-8 max-w-md text-center text-sm text-mute">
        Paid plans with larger file limits and batch processing are planned, but not live yet —
        <a href="/contact" class="font-medium text-brand-600 underline underline-offset-2 hover:text-brand-700">get in touch</a>
        if you'd like to be notified when they launch.
      </p>
    </div>
  </section>
</Layout>
