---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale ?? "en";
const t = useTranslations(lang);
const localePath = (path: string) => getRelativeLocaleUrl(lang, path);

const tiers = [
  {
    name: t("pricing.free.name"),
    price: "$0",
    period: t("pricing.free.period"),
    desc: t("pricing.free.desc"),
    features: [
      t("pricing.free.feature1"),
      t("pricing.free.feature2"),
      t("pricing.free.feature3"),
      t("pricing.free.feature4"),
    ],
    cta: t("pricing.free.cta"),
    href: localePath("/all-tools"),
    featured: false,
  },
  {
    name: t("pricing.pro.name"),
    price: "$9",
    period: t("pricing.pro.period"),
    desc: t("pricing.pro.desc"),
    features: [
      t("pricing.pro.feature1"),
      t("pricing.pro.feature2"),
      t("pricing.pro.feature3"),
      t("pricing.pro.feature4"),
      t("pricing.pro.feature5"),
    ],
    cta: t("pricing.pro.cta"),
    href: localePath("/all-tools"),
    featured: true,
  },
  {
    name: t("pricing.business.name"),
    price: "$29",
    period: t("pricing.business.period"),
    desc: t("pricing.business.desc"),
    features: [
      t("pricing.business.feature1"),
      t("pricing.business.feature2"),
      t("pricing.business.feature3"),
      t("pricing.business.feature4"),
    ],
    cta: t("pricing.business.cta"),
    href: localePath("/contact"),
    featured: false,
  },
] as const;
---

<Layout title="Pricing" description="Simple, transparent pricing for ConvertBrio's file conversion, compression, and AI tools.">
  <PageIntro
    eyebrow={t("pricing.eyebrow")}
    title={t("pricing.title")}
    description={t("pricing.description")}
  />

  <section aria-label="Pricing plans" class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          tiers.map((tier) => (
            <div
              class={`flex flex-col gap-6 rounded-2xl border p-8 ${
                tier.featured
                  ? "border-neutral-900 bg-neutral-900 text-white shadow-card-lg"
                  : "border-hairline bg-canvas text-ink shadow-card"
              }`}
            >
              <div>
                <div class="flex items-center justify-between">
                  <h2 class={`text-lg font-semibold ${tier.featured ? "text-white" : "text-ink"}`}>{tier.name}</h2>
                  {tier.featured && (
                    <span class="rounded-full bg-white/15 px-2.5 py-1 font-mono text-[11px] text-white">{t("pricing.popular")}</span>
                  )}
                </div>
                <p class={`mt-1 text-sm ${tier.featured ? "text-white/65" : "text-mute"}`}>{tier.desc}</p>
              </div>

              <div class="flex items-baseline gap-1.5">
                <span class="text-4xl font-semibold tracking-[-0.02em]">{tier.price}</span>
                <span class={`text-sm ${tier.featured ? "text-white/60" : "text-mute"}`}>/{tier.period}</span>
              </div>

              <ul class="flex flex-col gap-3">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <Icon
                      name="check"
                      class={`mt-0.5 h-4 w-4 shrink-0 ${tier.featured ? "text-white" : "text-success"}`}
                    />
                    <span class={tier.featured ? "text-white/85" : "text-body"}>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href={tier.href}
                class={`mt-auto inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-medium transition-opacity hover:opacity-90 ${
                  tier.featured ? "bg-white text-neutral-900" : "bg-ink text-canvas"
                }`}
              >
                {tier.cta}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-center text-sm text-mute">
        {t("pricing.footnote")}
      </p>
    </div>
  </section>
</Layout>
