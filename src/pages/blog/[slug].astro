---
import Layout from "../../layouts/Layout.astro";
import StripTodoComments from "../../components/StripTodoComments.astro";
import CtaSection from "../../components/CtaSection.astro";
import Icon from "../../components/Icon.astro";
import { Image, getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import { getTool } from "../../data/tools";
import { hubForTool } from "../../data/hubs";
import { assertPostImages } from "../../lib/assert-post-images";
import { ogPath } from "../../lib/og-paths";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  posts.forEach((post) => assertPostImages(post.id, post.body));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Optional header image. The optimized 1200px-wide copy doubles as the social
// preview and the Article schema image.
const hero = post.data.heroImage;
const heroOg = hero ? await getImage({ src: hero.src, width: 1200, format: "jpg" }) : undefined;

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

const base = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.convertbrio.com";
const postUrl = `${base}/blog/${post.id}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: base },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${base}/blog` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: heroOg ? new URL(heroOg.src, base).toString() : `${base}${ogPath.blog(post.id)}`,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  url: postUrl,
  mainEntityOfPage: postUrl,
  author: {
    "@type": "Person",
    name: post.data.author,
    url: `${base}/about`,
  },
  publisher: {
    "@type": "Organization",
    name: "ConvertBrio",
    url: base,
  },
};

const relatedTools = post.data.relatedTools.map((slug) => getTool(slug)).filter((tool) => tool !== undefined);
const hub = relatedTools[0] ? hubForTool(relatedTools[0]) : undefined;
---

<Layout title={post.data.title} seoTitle={post.data.seoTitle} description={post.data.description} canonical={`/blog/${post.id}`}
  image={heroOg?.src ?? ogPath.blog(post.id)}
  imageWidth={heroOg ? heroOg.attributes.width : undefined}
  imageHeight={heroOg ? heroOg.attributes.height : undefined}
  imageAlt={hero ? hero.alt : post.data.title}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  </Fragment>

  <div class="border-b border-hairline bg-canvas-soft">
    <div class="container-page flex flex-col items-start gap-3 py-14 sm:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-mute">
        By <a href="/about" class="font-medium text-ink hover:underline">{post.data.author}</a>
        {" · "}
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <>
            {" · Updated "}
            <time datetime={post.data.updatedDate.toISOString()}>{dateFormatter.format(post.data.updatedDate)}</time>
          </>
        )}
      </p>
      <h1 class="max-w-3xl text-balance text-3xl font-semibold tracking-[-0.01em] text-ink sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="max-w-xl text-balance text-body">{post.data.description}</p>
      {
        hero && (
          <Image
            src={hero.src}
            alt={hero.alt}
            width={1200}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 768px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="mt-6 h-auto w-full max-w-3xl rounded-xl border border-hairline"
          />
        )
      }
    </div>
  </div>

  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-2xl">
        <div class="prose prose-neutral max-w-none prose-headings:tracking-[-0.01em] prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-img:h-auto prose-img:w-full prose-img:rounded-lg prose-img:border prose-img:border-hairline">
          <StripTodoComments><Content /></StripTodoComments>
        </div>

        {
          relatedTools.length > 0 && (
            <div class="mt-12 rounded-2xl border border-hairline bg-canvas-soft p-6 sm:p-8">
              <h2 class="font-mono text-xs uppercase tracking-wide text-mute">Related tools</h2>
              <ul class="mt-4 flex flex-wrap gap-3">
                {relatedTools.map((tool) => (
                  <li>
                    <a
                      href={`/tools/${tool!.slug}`}
                      class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2"
                    >
                      <Icon name={tool!.icon} class="h-4 w-4" />
                      {tool!.name}
                    </a>
                  </li>
                ))}
              </ul>
              {hub && (
                <p class="mt-4 text-sm text-body">
                  Browse all{" "}
                  <a href={hub.path} class="text-brand-600 underline underline-offset-2 hover:text-brand-700">
                    {hub.name.toLowerCase()}
                  </a>
                </p>
              )}
            </div>
          )
        }

        <a href="/blog" class="mt-10 inline-flex items-center gap-2 text-sm text-brand-600 underline underline-offset-2 hover:text-brand-700">
          <Icon name="arrow" class="h-4 w-4 rotate-180" />
          Back to blog
        </a>
      </div>
    </div>
  </section>

  <CtaSection />
</Layout>
