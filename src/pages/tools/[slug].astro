---
import ToolPage from "../../components/ToolPage.astro";
import { tools } from "../../data/tools";

export const prerender = true;

export function getStaticPaths() {
  // External tools (e.g. internet-speed-test) have their own dedicated route
  // that redirects instead of rendering this conversion-form template.
  return tools.filter((tool) => tool.kind !== "external").map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");
---

<ToolPage slug={slug} lang="en" />
