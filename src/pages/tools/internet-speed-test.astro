---
// Server-rendered (not prerendered) so this issues a real HTTP redirect at
// request time, in both `astro dev` and production - a prerendered/static
// page can't guarantee a true 30x the way a request-time redirect can.
export const prerender = false;

// Matches the external destination configured for this tool in data/tools.ts.
return Astro.redirect("https://liveinternetspeed.com/", 302);
---
