---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import Icon from "../../components/Icon.astro";
import { toolI18nPt } from "../../data/i18n";

const groups: { id: string; title: string; slugs: string[] }[] = [
  { id: "pdf", title: "Ferramentas PDF", slugs: ["compress-pdf", "merge-pdf", "split-pdf", "pdf-to-word", "pdf-to-jpg", "ocr-pdf"] },
  { id: "image", title: "Ferramentas de imagem", slugs: ["compress-image", "image-converter", "jpg-to-pdf"] },
  { id: "document", title: "Ferramentas de documento", slugs: ["word-to-pdf", "compress-word", "compress-powerpoint"] },
];

const iconFor: Record<string, string> = {
  "compress-pdf": "shrink",
  "merge-pdf": "merge",
  "split-pdf": "merge",
  "pdf-to-word": "pdf",
  "pdf-to-jpg": "pdf",
  "ocr-pdf": "ocr",
  "compress-image": "shrink",
  "image-converter": "image",
  "jpg-to-pdf": "image",
  "word-to-pdf": "word",
  "compress-word": "shrink",
  "compress-powerpoint": "shrink",
};

const card =
  "flex items-start gap-3 rounded-xl border border-hairline bg-canvas-soft p-4 transition-transform duration-150 hover:-translate-y-0.5";
---

<Layout
  title="Todas as ferramentas"
  seoTitle="Todas as Ferramentas — Comprimir e Converter PDF e Imagem | ConvertBrio"
  description="Todas as ferramentas do ConvertBrio em português: comprimir PDF, comprimir imagem, juntar PDF, PDF para Word, OCR e mais. Grátis, sem cadastro."
  canonical="/pt/all-tools"
  lang="pt"
  alternates={{ en: "/all-tools", pt: "/pt/all-tools" }}
>
  <PageIntro
    eyebrow="Ferramentas"
    title="Todas as ferramentas"
    description="As ferramentas de PDF, imagem e documento em português. Grátis, sem cadastro, sem marca d'água."
  />

  <section class="bg-canvas">
    <div class="container-page flex flex-col gap-14 py-16 sm:py-20">
      {
        groups.map((group) => (
          <div id={group.id}>
            <h2 class="text-xl font-semibold text-ink">{group.title}</h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {group.slugs.map((slug) => (
                <a href={`/pt/tools/${slug}`} class={card}>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                    <Icon name={iconFor[slug] as any} class="h-4 w-4" />
                  </span>
                  <span class="flex flex-col gap-0.5">
                    <span class="font-medium text-ink">{toolI18nPt[slug].name}</span>
                    <span class="text-sm leading-relaxed text-body">{toolI18nPt[slug].description}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <p class="text-sm text-body">
        Precisa de outra ferramenta? O <a href="/all-tools" class="font-medium text-brand-600 underline underline-offset-2">catálogo completo</a>
        (em inglês) tem conversores para AVIF, WEBP, HEIC, ferramentas de rotação, recorte e IA.
      </p>
    </div>
  </section>
</Layout>
