---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import FaqSection from "../../components/FaqSection.astro";
import { toolI18nPt } from "../../data/i18n";

const seoTitle = "ConvertBrio — Conversor e Compressor de Arquivos Online Grátis";
const description =
  "Converta, comprima e edite imagens, PDFs e documentos online — grátis, privado, sem cadastro. Inclui um compressor de imagem que atinge um tamanho exato em KB.";
const url = "https://www.convertbrio.com/pt";

const websiteSchema = { "@context": "https://schema.org", "@type": "WebSite", name: "ConvertBrio", url, description, inLanguage: "pt-BR" };
const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ConvertBrio",
  url,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (web-based)",
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const popular: { slug: string; icon: string; blurb: string }[] = [
  { slug: "compress-pdf", icon: "shrink", blurb: "Reduza o tamanho de um PDF para e-mail ou envio em portais." },
  { slug: "compress-image", icon: "shrink", blurb: "Chegue a um tamanho exato em KB — 100 KB para vistos e concursos." },
  { slug: "merge-pdf", icon: "merge", blurb: "Combine vários PDFs em um só documento, na ordem que quiser." },
  { slug: "pdf-to-word", icon: "word", blurb: "Transforme um PDF em um DOCX editável." },
  { slug: "word-to-pdf", icon: "word", blurb: "Converta um documento Word em um PDF que abre em qualquer lugar." },
  { slug: "jpg-to-pdf", icon: "image", blurb: "Junte fotos e digitalizações em um único PDF." },
  { slug: "pdf-to-jpg", icon: "pdf", blurb: "Exporte cada página do PDF como uma imagem." },
  { slug: "ocr-pdf", icon: "ocr", blurb: "Torne um PDF digitalizado pesquisável e leve o texto para o Word." },
];

const categories: { title: string; desc: string; href: string; icon: string }[] = [
  { title: "Ferramentas PDF", desc: "Juntar, dividir, comprimir e converter PDFs.", href: "/pt/all-tools#pdf", icon: "pdf" },
  { title: "Ferramentas de imagem", desc: "Converter, redimensionar e comprimir imagens.", href: "/pt/all-tools#image", icon: "image" },
  { title: "Ferramentas de documento", desc: "Word ↔ PDF e compressão de Office.", href: "/pt/all-tools#document", icon: "word" },
];

const faq = [
  {
    question: "O ConvertBrio é grátis?",
    answer:
      "Sim. Todas as ferramentas são gratuitas, sem cadastro, sem limite de uso e sem marca d'água. Arquivos de até 100 MB por conversão são aceitos sem custo.",
  },
  {
    question: "Como comprimir um PDF online de graça?",
    answer:
      "Abra a ferramenta Comprimir PDF, envie o documento e clique em Comprimir. Ela re-codifica as imagens embutidas e remove metadados desnecessários para reduzir o arquivo, que é baixado automaticamente.",
  },
  {
    question: "Meus arquivos estão seguros?",
    answer:
      "Todo arquivo enviado trafega por uma conexão criptografada e é processado automaticamente, sem revisão humana. O original e o resultado são apagados dos servidores em até 24 horas.",
  },
  {
    question: "Consigo usar no celular?",
    answer:
      "Sim. Abra o ConvertBrio no navegador do celular ou tablet e todas as ferramentas funcionam igual ao computador, sem aplicativo para instalar.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
};

const card =
  "flex flex-col gap-2 rounded-2xl border border-hairline bg-canvas-soft p-5 shadow-card transition-transform duration-150 hover:-translate-y-0.5";
---

<Layout
  title="ConvertBrio"
  seoTitle={seoTitle}
  description={description}
  canonical="/pt"
  lang="pt"
  alternates={{ en: "/", pt: "/pt" }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col items-start gap-5">
        <span class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1 font-mono text-xs text-body">
          <Icon name="check" class="h-3.5 w-3.5" />
          Grátis, privado, sem cadastro
        </span>
        <h1 class="text-3xl font-semibold tracking-[-0.01em] text-ink sm:text-4xl">
          Converta, comprima e edite seus arquivos — direto no navegador.
        </h1>
        <p class="max-w-xl text-balance leading-relaxed text-body">
          Imagens, PDFs e documentos, sem instalar nada. Precisa de uma foto num tamanho exato em KB para um
          formulário ou portal? Nosso compressor atinge o KB alvo sem tentativa e erro.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/pt/tools/compress-pdf"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
          >
            Comprimir PDF
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a
            href="/pt/all-tools"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-hairline bg-canvas px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2"
          >
            Ver todas as ferramentas
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-card">
        <p class="font-mono text-xs uppercase tracking-wide text-mute">Ferramentas populares</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            popular.slice(0, 6).map((tool) => (
              <li>
                <a href={`/pt/tools/${tool.slug}`} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink">
                  <Icon name={tool.icon as any} class="h-4 w-4 shrink-0 text-mute" />
                  {toolI18nPt[tool.slug].name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">As ferramentas mais usadas</h2>
      <p class="mt-3 text-body">Sem cadastro, sem marca d'água, arquivos apagados automaticamente em 24 horas.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          popular.map((tool) => (
            <a href={`/pt/tools/${tool.slug}`} class={card}>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                <Icon name={tool.icon as any} class="h-4 w-4" />
              </span>
              <span class="font-medium text-ink">{toolI18nPt[tool.slug].name}</span>
              <span class="text-sm leading-relaxed text-body">{tool.blurb}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">Por categoria</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          categories.map((cat) => (
            <a href={cat.href} class={card}>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                <Icon name={cat.icon as any} class="h-4 w-4" />
              </span>
              <span class="font-medium text-ink">{cat.title}</span>
              <span class="text-sm leading-relaxed text-body">{cat.desc}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">
          ConvertBrio: um conversor grátis para imagens, PDFs e documentos
        </h2>
        <p class="mt-4 leading-relaxed text-body">
          O ConvertBrio é um conversor de arquivos online e gratuito, feito para quem precisa converter, comprimir ou
          organizar um arquivo sem instalar programa nem criar conta. Seja para mudar o formato de uma imagem, reduzir
          o tamanho de um PDF ou transformar um documento Word em um PDF, envie do navegador e os servidores do
          ConvertBrio fazem a conversão em segundos.
        </p>
        <h3 class="mt-10 text-lg font-semibold text-ink">Comprimir PDF e imagem para um tamanho exato</h3>
        <p class="mt-3 leading-relaxed text-body">
          Portais de visto, sites de concurso e formulários do governo costumam limitar um anexo a um tamanho exato,
          como 100 KB ou 2 MB. A ferramenta <a href="/pt/tools/compress-image" class="font-medium text-brand-600 underline underline-offset-2">Comprimir Imagem</a>
          aceita um alvo em KB e chega nele; a ferramenta <a href="/pt/tools/compress-pdf" class="font-medium text-brand-600 underline underline-offset-2">Comprimir PDF</a>
          re-codifica as imagens embutidas para reduzir o arquivo mantendo o texto nítido.
        </p>
        <h3 class="mt-10 text-lg font-semibold text-ink">Trabalhar com PDFs</h3>
        <p class="mt-3 leading-relaxed text-body">
          <a href="/pt/tools/merge-pdf" class="font-medium text-brand-600 underline underline-offset-2">Juntar PDF</a> combina
          vários arquivos em um só; <a href="/pt/tools/split-pdf" class="font-medium text-brand-600 underline underline-offset-2">Dividir PDF</a>
          separa um documento em páginas; <a href="/pt/tools/pdf-to-jpg" class="font-medium text-brand-600 underline underline-offset-2">PDF para JPG</a>
          exporta cada página como imagem; e <a href="/pt/tools/jpg-to-pdf" class="font-medium text-brand-600 underline underline-offset-2">JPG para PDF</a>
          transforma fotos de documentos em um PDF pronto para enviar.
        </p>
        <h3 class="mt-10 text-lg font-semibold text-ink">Documentos digitalizados e Word</h3>
        <p class="mt-3 leading-relaxed text-body">
          Para levar um documento digitalizado para o Word, use <a href="/pt/tools/ocr-pdf" class="font-medium text-brand-600 underline underline-offset-2">OCR de PDF</a>
          para reconhecer o texto e depois <a href="/pt/tools/pdf-to-word" class="font-medium text-brand-600 underline underline-offset-2">PDF para Word</a>
          para obter um DOCX editável. A privacidade vem de fábrica: todo envio é criptografado, o processamento é
          automático e os arquivos são apagados em 24 horas.
        </p>
      </div>
    </div>
  </section>

  <FaqSection
    items={faq}
    heading="Perguntas frequentes"
    description="Respostas para as dúvidas mais comuns sobre converter, comprimir e organizar arquivos com o ConvertBrio."
    id="faq"
  />

  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="relative overflow-hidden rounded-2xl border border-hairline bg-canvas-soft px-6 py-14 text-center sm:px-12 sm:py-16">
        <h2 class="mx-auto max-w-xl text-balance text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">
          Pronto para converter seu primeiro arquivo?
        </h2>
        <p class="mx-auto mt-3 max-w-md text-balance text-body">Sem conta para começar, e todas as ferramentas são grátis.</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/pt/tools/compress-pdf" class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90">
            Comprimir PDF
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/pt/all-tools" class="inline-flex items-center justify-center gap-2 rounded-full border border-hairline bg-canvas px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2">
            Ver todas as ferramentas
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
