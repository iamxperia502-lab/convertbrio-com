---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import FaqSection from "../../components/FaqSection.astro";
import { NON_DEFAULT_LOCALES, alternatesFor, toolMetaByLocale, type Locale } from "../../data/i18n";
import { organization, webSite, faqPage } from "../../lib/structured-data";
import { homepageByLocale, HOME_POPULAR_SLUGS } from "../../data/i18n-home";

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const c = homepageByLocale[lang as Exclude<Locale, "en">];
const meta = toolMetaByLocale[lang]!;
const url = `https://www.convertbrio.com/${lang}`;

const iconFor: Record<string, string> = {
  "compress-pdf": "shrink",
  "compress-image": "shrink",
  "merge-pdf": "merge",
  "pdf-to-word": "pdf",
  "word-to-pdf": "word",
  "jpg-to-pdf": "image",
  "pdf-to-jpg": "pdf",
  "ocr-pdf": "ocr",
  pdf: "pdf",
  image: "image",
  document: "word",
};

const siteBase = url.replace(/\/[a-z]{2}\/?$/, "").replace(/\/$/, "");
const jsonLd = [organization(siteBase), webSite(siteBase, { description: c.description, lang, url }), faqPage(c.faq)];

const card =
  "flex flex-col gap-2 rounded-2xl border border-hairline bg-canvas-soft p-5 shadow-card transition-transform duration-150 hover:-translate-y-0.5";
---

<Layout
  title="ConvertBrio"
  seoTitle={c.seoTitle}
  description={c.description}
  canonical={`/${lang}`}
  lang={lang}
  alternates={alternatesFor("/")}
  jsonLd={jsonLd}
>
  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:items-center">
      <div class="flex flex-col items-start gap-5">
        <span class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1 font-mono text-xs text-body">
          <Icon name="check" class="h-3.5 w-3.5" />
          {c.badge}
        </span>
        <h1 class="text-3xl font-semibold tracking-[-0.01em] text-ink sm:text-4xl">{c.heroTitle}</h1>
        <p class="max-w-xl text-balance leading-relaxed text-body">{c.heroIntro}</p>
        <div class="flex flex-wrap gap-3">
          <a href={`/${lang}/tools/compress-pdf`} class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90">
            {c.ctaPrimary}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={`/${lang}/all-tools`} class="inline-flex items-center justify-center gap-2 rounded-full border border-hairline bg-canvas px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2">
            {c.ctaSecondary}
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-card">
        <p class="font-mono text-xs uppercase tracking-wide text-mute">{c.popularPanelLabel}</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            HOME_POPULAR_SLUGS.slice(0, 6).map((slug) => (
              <li>
                <a href={`/${lang}/tools/${slug}`} class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink">
                  <Icon name={iconFor[slug] as any} class="h-4 w-4 shrink-0 text-mute" />
                  {meta[slug].name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">{c.popularHeading}</h2>
      <p class="mt-3 text-body">{c.popularSub}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          HOME_POPULAR_SLUGS.map((slug) => (
            <a href={`/${lang}/tools/${slug}`} class={card}>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                <Icon name={iconFor[slug] as any} class="h-4 w-4" />
              </span>
              <span class="font-medium text-ink">{meta[slug].name}</span>
              <span class="text-sm leading-relaxed text-body">{c.blurbs[slug]}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas-soft">
    <div class="container-page py-16 sm:py-20">
      <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">{c.categoriesHeading}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          c.categories.map((cat) => (
            <a href={`/${lang}/all-tools#${cat.id}`} class={card}>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-canvas-soft-2 text-ink">
                <Icon name={iconFor[cat.id] as any} class="h-4 w-4" />
              </span>
              <span class="font-medium text-ink">{cat.title}</span>
              <span class="text-sm leading-relaxed text-body">{cat.desc}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-hairline bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">{c.seoHeading}</h2>
        <p class="mt-4 leading-relaxed text-body">{c.seoIntro}</p>
        {
          c.seoBlocks.map((block) => (
            <>
              <h3 class="mt-10 text-lg font-semibold text-ink">{block.h3}</h3>
              <p class="mt-3 leading-relaxed text-body" set:html={block.html} />
            </>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection items={c.faq} heading={c.faqHeading} description={c.faqSub} id="faq" />

  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="relative overflow-hidden rounded-2xl border border-hairline bg-canvas-soft px-6 py-14 text-center sm:px-12 sm:py-16">
        <h2 class="mx-auto max-w-xl text-balance text-2xl font-semibold tracking-[-0.01em] text-ink sm:text-3xl">{c.ctaHeading}</h2>
        <p class="mx-auto mt-3 max-w-md text-balance text-body">{c.ctaSub}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={`/${lang}/tools/compress-pdf`} class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-opacity hover:opacity-90">
            {c.ctaPrimary}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href={`/${lang}/all-tools`} class="inline-flex items-center justify-center gap-2 rounded-full border border-hairline bg-canvas px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-canvas-soft-2">
            {c.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
