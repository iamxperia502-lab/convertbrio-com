---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { NON_DEFAULT_LOCALES, alternatesFor, type Locale } from "../../../data/i18n";
import { pagesByLocale } from "../../../data/page-content";

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.filter((l) => pagesByLocale[l]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const doc = pagesByLocale[lang]!.blogIndex;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = new Intl.DateTimeFormat(doc.dateLocale, { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={doc.title} seoTitle={doc.seoTitle} description={doc.description} canonical={`/${lang}/blog`} lang={lang} alternates={alternatesFor("/blog")}>
  <PageIntro eyebrow={doc.eyebrow} title={doc.heading} description={doc.intro} />
  <section class="bg-canvas">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto grid max-w-3xl gap-8">
        <p class="text-sm text-mute">{doc.englishNote}</p>
        {
          posts.map((post) => (
            <article class="border-b border-hairline pb-8 last:border-b-0 last:pb-0">
              <a href={`/blog/${post.id}`} hreflang="en" class="group flex flex-col gap-2">
                <p class="font-mono text-xs uppercase tracking-wide text-mute">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time> · EN
                </p>
                <h2 class="text-xl font-semibold tracking-[-0.01em] text-ink group-hover:underline sm:text-2xl">{post.data.title}</h2>
                <p class="text-balance text-body">{post.data.description}</p>
              </a>
            </article>
          ))
        }
        {posts.length === 0 && <p class="text-body">{doc.empty}</p>}
      </div>
    </div>
  </section>
</Layout>
